          "Message: " + (message || "Please share availability and details.") +
          "\n\nThank you.";

        const whatsappURL =
          "https://wa.me/919731722758?text=" +
          encodeURIComponent(whatsappMessage);

        window.open(whatsappURL, "_blank", "noopener,noreferrer");
      }
    );
  </script>

