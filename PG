
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>NEW LOKANATH LADIES PG | Kundalahalli, Bengaluru</title>

  <meta name="description"
    content="Explore NEW LOKANATH LADIES PG in Kundalahalli, Bengaluru. Compare single, double and triple sharing rooms, explore amenities and contact us for availability.">

  <meta name="theme-color" content="#f4775d">

  <style>
    :root {
      --orange: #f4775d;
      --orange-dark: #df6049;
      --pink: #fff0ed;
      --cream: #fffaf6;
      --dark: #292323;
      --muted: #6f6765;
      --white: #ffffff;
      --border: #f1dcd6;
      --green: #218653;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 85px;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--dark);
      background: var(--cream);
      line-height: 1.7;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button, a {
      -webkit-tap-highlight-color: transparent;
    }

    img {
      max-width: 100%;
    }

    .container {
      width: min(1120px, 90%);
      margin: auto;
    }

    /* Navigation */

    header {
      background: rgba(255, 250, 246, 0.97);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .navbar {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-size: 19px;
      font-weight: 800;
      color: var(--orange-dark);
      line-height: 1.2;
    }

    .logo span {
      display: block;
      font-size: 11px;
      color: var(--muted);
      letter-spacing: 3px;
      margin-top: 5px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 23px;
      font-size: 14px;
      font-weight: 600;
    }

    .nav-links a:hover {
      color: var(--orange-dark);
    }

    .nav-cta, .btn {
      display: inline-block;
      padding: 12px 21px;
      border-radius: 9px;
      background: var(--orange);
      color: white;
      font-weight: 700;
      border: 0;
      cursor: pointer;
      transition: 0.2s;
    }

    .nav-cta:hover, .btn:hover {
      background: var(--orange-dark);
      transform: translateY(-2px);
    }

    .menu-toggle {
      display: none;
      background: none;
      border: 0;
      font-size: 27px;
      cursor: pointer;
    }

    /* Hero section */

    .hero {
      background: linear-gradient(135deg, #fff0ed, #ffddd4);
      padding: 85px 0;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 55px;
      align-items: center;
    }

    .eyebrow {
      color: var(--orange-dark);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(36px, 5vw, 57px);
      line-height: 1.12;
      margin: 17px 0;
      letter-spacing: -1.5px;
    }

    h1 span {
      color: var(--orange-dark);
    }

    .hero p {
      color: var(--muted);
      font-size: 17px;
      max-width: 550px;
      margin-bottom: 25px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn-outline {
      display: inline-block;
      padding: 11px 20px;
      border: 1px solid var(--orange);
      color: var(--orange-dark);
      border-radius: 9px;
      font-weight: 700;
    }

    .hero-image {
      min-height: 390px;
      border-radius: 24px;
      background: #f8c8bc;
      overflow: hidden;
      box-shadow: 0 20px 45px #7d46301c;
    }

    .hero-image img {
      width: 100%;
      height: 390px;
      object-fit: cover;
      display: block;
    }

    .trust-row {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      margin-top: 28px;
      color: #514845;
      font-size: 13px;
      font-weight: 600;
    }

    /* General sections */

    section {
      padding: 76px 0;
    }

    .section-heading {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 38px;
    }

    .section-heading h2 {
      font-size: clamp(28px, 4vw, 38px);
      line-height: 1.25;
      margin: 9px 0 12px;
    }

    .section-heading p {
      color: var(--muted);
    }

    .about-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 17px;
    }

    .feature-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 24px 19px;
    }

    .feature-icon {
      width: 45px;
      height: 45px;
      background: var(--pink);
      display: grid;
      place-items: center;
      border-radius: 12px;
      font-size: 22px;
      margin-bottom: 14px;
    }

    .feature-card h3 {
      font-size: 17px;
      margin-bottom: 7px;
    }

    .feature-card p {
      color: var(--muted);
      font-size: 14px;
    }

    /* Why choose us */

    .why {
      background: var(--pink);
    }

    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 45px;
    }

    .why-copy h2 {
      font-size: 35px;
      line-height: 1.25;
      margin: 12px 0 18px;
    }

    .why-copy p {
      color: var(--muted);
      margin-bottom: 16px;
    }

    .check-list {
      list-style: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 22px;
    }

    .check-list li {
      font-size: 14px;
      font-weight: 600;
    }

    .check-list li::before {
      content: "✓ ";
      color: var(--green);
      font-weight: 900;
    }

    .why-image {
      border-radius: 20px;
      overflow: hidden;
      background: #f6d5ca;
      min-height: 300px;
    }

    .why-image img {
      width: 100%;
      height: 340px;
      object-fit: cover;
      display: block;
    }

    /* Rooms */

    .rooms-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      align-items: stretch;
    }

    .room-card {
      position: relative;
      background: white;
      border: 1px solid var(--border);
      border-radius: 17px;
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 8px 25px #6a33200a;
    }

    .room-card.popular {
      border: 2px solid var(--orange);
    }

    .popular-label {
      position: absolute;
      top: -14px;
      right: 20px;
      background: var(--orange);
      color: white;
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 11px;
      font-weight: 800;
    }

    .room-card h3 {
      font-size: 22px;
    }

    .room-type {
      color: var(--muted);
      font-size: 14px;
    }

    .price {
      color: var(--orange-dark);
      font-size: 28px;
      font-weight: 800;
      margin: 18px 0;
      line-height: 1.3;
    }

    .price small {
      display: block;
      font-size: 13px;
      color: var(--muted);
      font-weight: 400;
    }

    .room-card ul {
      list-style: none;
      margin-bottom: 24px;
      flex: 1;
    }

    .room-card li {
      padding: 7px 0;
      font-size: 14px;
      border-bottom: 1px solid #f5efec;
    }

    .room-card li::before {
      content: "✓ ";
      color: var(--green);
      font-weight: 800;
    }

    .room-card .btn {
      text-align: center;
    }

    .price-note {
      margin-top: 25px;
      text-align: center;
      color: var(--muted);
      font-size: 13px;
    }

    /* Amenities */

    .amenities {
      background: #fff4ef;
    }

    .amenities-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .amenity {
      display: flex;
      align-items: flex-start;
      gap: 13px;
      background: white;
      padding: 18px;
      border-radius: 12px;
      border: 1px solid #f5e6df;
    }

    .amenity-icon {
      font-size: 23px;
    }

    .amenity h3 {
      font-size: 15px;
      margin-bottom: 4px;
    }

    .amenity p {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }

    .benefits {
      margin-top: 28px;
      padding: 25px;
      background: #ffe1d8;
      border-radius: 15px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      text-align: center;
      gap: 20px;
    }

    .benefits strong {
      color: var(--orange-dark);
      font-size: 20px;
      display: block;
    }

    .benefits span {
      font-size: 13px;
      color: var(--muted);
    }

    /* Contact */

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }

    .contact-card, .contact-form {
      padding: 28px;
      border: 1px solid var(--border);
      background: white;
      border-radius: 17px;
    }

    .contact-item {
      display: flex;
      gap: 15px;
      padding: 17px 0;
      border-bottom: 1px solid #f3e9e5;
    }

    .contact-item:last-child {
      border-bottom: 0;
    }

    .contact-item .feature-icon {
      flex-shrink: 0;
      margin: 0;
    }

    .contact-item h3 {
      font-size: 15px;
      margin-bottom: 3px;
    }

    .contact-item p, .contact-item a {
      color: var(--muted);
      font-size: 14px;
      overflow-wrap: anywhere;
    }

    .contact-item a:hover {
      color: var(--orange-dark);
    }

    .contact-form h3 {
      font-size: 22px;
      margin-bottom: 5px;
    }

    .contact-form > p {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #e7d8d2;
      border-radius: 8px;
      background: #fffdfc;
      color: var(--dark);
      font: inherit;
      font-size: 14px;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: 2px solid #f9b4a5;
      border-color: var(--orange);
    }

    .contact-form .btn {
      width: 100%;
      font-size: 15px;
    }

    .form-note {
      font-size: 12px !important;
      margin-top: 12px;
    }

    /* Footer */

    footer {
      background: #302624;
      color: white;
      padding: 35px 0;
      text-align: center;
    }

    footer p {
      font-size: 13px;
      color: #e4d4cf;
      margin-top: 6px;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 17px;
      font-size: 13px;
    }

    .footer-links a:hover {
      color: #ffb6a6;
    }

    .whatsapp-float {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 90;
      width: 57px;
      height: 57px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #25d366;
      color: white;
      font-size: 27px;
      box-shadow: 0 5px 18px #0002;
    }

    .whatsapp-float:hover {
      transform: scale(1.06);
    }

    /* Responsive design */

    @media (max-width: 900px) {
      .hero-grid, .why-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .hero {
        padding: 55px 0;
      }

      .hero-image, .hero-image img {
        min-height: 300px;
        height: 300px;
      }

      .about-grid, .amenities-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .rooms-grid {
        gap: 14px;
      }

      .room-card {
        padding: 24px 17px;
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .navbar {
        min-height: 68px;
      }

      .menu-toggle {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 68px;
        left: 0;
        width: 100%;
        padding: 20px 5%;
        background: var(--cream);
        border-bottom: 1px solid var(--border);
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        padding: 5px 0;
      }

      .nav-cta {
        text-align: center;
      }

      h1 {
        font-size: 39px;
      }

      section {
        padding: 55px 0;
      }

      .about-grid, .amenities-grid, .rooms-grid {
        grid-template-columns: 1fr;
      }

      .room-card {
        padding: 27px 23px;
      }

      .check-list {
        grid-template-columns: 1fr;
      }

      .benefits {
        grid-template-columns: 1fr;
      }

      .contact-card, .contact-form {
        padding: 22px 18px;
      }

      .hero-image, .hero-image img {
        height: 250px;
        min-height: 250px;
      }

      .trust-row {
        gap: 10px;
      }
    }
  </style>
</head>

